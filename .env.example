NEXT_PUBLIC_GHL_WEBHOOK_URL=
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=appAGZVUJmvnyDAL1

# Payment pages (pay. subdomain), from your Stripe dashboard
STRIPE_SECRET_KEY=
# From the webhook endpoint you create in Stripe (Developers > Webhooks),
# pointing at https://pay.yourlocalgardendesigner.co.uk/api/stripe-webhook
STRIPE_WEBHOOK_SECRET=

# Dedicated GHL workflow for order notifications, deliberately separate from
# NEXT_PUBLIC_GHL_WEBHOOK_URL above, which is for quiz leads only. Get this
# URL from the "Inbound Webhook" trigger step of the new GHL order workflow.
GHL_ORDERS_WEBHOOK_URL=

# Test mode for payment pages — lets you run a real checkout flow with
# Stripe's test card (4242 4242 4242 4242) any time, with zero real money
# moving, without ever swapping the live keys above.
# 1. In Stripe, switch to Test mode, then Developers > API keys > Secret key.
STRIPE_SECRET_KEY_TEST=
# 2. In Test mode, Developers > Webhooks > add an endpoint with the SAME url
#    as the live one (https://pay.yourlocalgardendesigner.co.uk/api/stripe-webhook),
#    same event (checkout.session.completed) > copy its signing secret.
STRIPE_WEBHOOK_SECRET_TEST=
# 3. Make up any private string — this is the code you append as
#    ?test=<code> to a pay page to switch that one checkout into test mode.
#    Keep it private; anyone with it can trigger test checkouts (harmless,
#    but noisy in the Orders table / GHL if it leaks).
STRIPE_TEST_ACCESS_CODE=
